{
  "name": "robisit-site-tooling",
  "private": true,
  "description": "Dev tooling for robisit.com. Nothing here ships to the site.",
  "scripts": {
    "build": "bash scripts/build-site.sh",
    "narrate": "node scripts/narrate.js",
    "carousel": "node scripts/carousel.js",
    "validate:cards": "node scripts/validate-cards.js --site _site",
    "test": "npm run test:unit && playwright test",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:clean": "rm -rf _site test-results playwright-report && npm run build && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "google-auth-library": "^11.3.1",
    "js-yaml": "^5.5.0"
  }
}
