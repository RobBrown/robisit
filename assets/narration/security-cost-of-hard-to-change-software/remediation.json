  "audio": "/assets/narration/security-cost-of-hard-to-change-software/remediation.mp3",
  "duration": 30.24,
  "phrases": [
    {
      "id": "p0",
      "text": "Finding vulnerabilities is getting easier.",
      "start": 0.092,
      "end": 2.562
    },
    {
      "id": "p1",
      "text": "Fixing them isn't.",
      "start": 2.562,
      "end": 3.897
    },
    {
      "id": "p2",
      "text": "Verizon found",
      "start": 3.897,
      "end": 4.668
    },
    {
      "id": "p3",
      "text": "that organizations fully",
      "start": 4.668,
      "end": 5.812
    },
    {
      "id": "p4",
      "text": "remediated only 26%",
      "start": 5.812,
      "end": 7.597
    },
    {
      "id": "p5",
      "text": "of known exploited",
      "start": 7.597,
      "end": 8.465
    },
    {
      "id": "p6",
      "text": "vulnerabilities in 2025.",
      "start": 8.465,
      "end": 11.144
    },
    {
      "id": "p7",
      "text": "Median remediation time",
      "start": 11.144,
      "end": 12.405
    },
    {
      "id": "p8",
      "text": "reached 43 days.",
      "start": 12.405,
      "end": 13.982
    },
    {
      "id": "p9",
      "text": "AI accelerates discovery,",
      "start": 13.982,
      "end": 15.921
    },
    {
      "id": "p10",
      "text": "but production changes",
      "start": 15.921,
      "end": 16.889
    },
    {
      "id": "p11",
      "text": "still require testing,",
      "start": 16.889,
      "end": 18.66
    },
    {
      "id": "p12",
      "text": "coordination, and deployment.",
      "start": 18.66,
      "end": 21.242
    },
    {
      "id": "p13",
      "text": "A vulnerability discovered",
      "start": 21.242,
      "end": 22.616
    },
    {
      "id": "p14",
      "text": "in hours can",
      "start": 22.616,
      "end": 23.34
    },
    {
      "id": "p15",
      "text": "remain exposed for weeks.",
      "start": 23.34,
      "end": 25.05
    },
    {
      "id": "p16",
      "text": "The constraint is",
      "start": 25.05,
      "end": 25.764
    },
    {
      "id": "p17",
      "text": "no longer just",
      "start": 25.764,
      "end": 26.464
    },
    {
      "id": "p18",
      "text": "knowing what is wrong.",
      "start": 26.464,
      "end": 27.848
    },
    {
      "id": "p19",
      "text": "It is being",
      "start": 27.848,
      "end": 28.285
    },
    {
      "id": "p20",
      "text": "able to change",
      "start": 28.285,
      "end": 28.896
    },
    {
      "id": "p21",
      "text": "the system safely.",
      "start": 28.896,
      "end": 30.24
    }
  ]
}
